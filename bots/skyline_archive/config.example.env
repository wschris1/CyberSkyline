# Copy to .env in this directory. Keep real tokens out of Git and chat.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Your Discord user ID. Multiple owners can be separated by commas.
DISCORD_OWNER_IDS=

# Fine-grained GitHub token: this repository only, Contents read/write.
GITHUB_TOKEN=
GITHUB_REPOSITORY=wschris1/wschris-CyberSecurity
GITHUB_BRANCH=main

# An event overview URL (/world/...) from Cyber Skyline.
# Leave blank and pass event_url to /ws sync, or use /ws sync-all.
WS_EVENT_URL=
# 0 disables the timer. 10–10080 enables automatic sync of WS_EVENT_URL.
SYNC_INTERVAL_MINUTES=0
REQUEST_DELAY_SECONDS=2
MAX_CHALLENGES=2000
# Local private state defaults to your OS application-data directory.
# WS_STATE_DIR=C:\WSBotData
# Set false to see the scanner window while troubleshooting.
HEADLESS=true

# Optional initial defaults; /ws settings saves private overrides.
DISCORD_ARCHIVE_HUB_ID=0
DISCORD_NOTIFICATION_CHANNEL_ID=0
DEFAULT_PREVIEW=false
# Also enable Message Content Intent in the Discord Developer Portal.
# False keeps explicit /ws verify answer: and modal answers working.
DISCORD_MESSAGE_CONTENT=false

# Optional OpenAI assistance for inconclusive manual /ws verify jobs.
# Questions, answers and bounded evidence excerpts go to OpenAI when enabled.
# Keep this key private. Never enter it in Discord, chat or GitHub.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_VERIFY_ENABLED=false
AI_MAX_DAILY_REQUESTS=40
AI_MAX_OUTPUT_TOKENS=1600
AI_TIMEOUT_SECONDS=120

# Existing SKYLINE_EVENT_URL / SKYLINE_STATE_DIR settings remain accepted.
# WS_ aliases take precedence when explicitly set; keep the same existing state directory.
